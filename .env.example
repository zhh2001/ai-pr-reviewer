# GitHub personal access token，需要 repo 读权限（拉 PR diff 用）
GITHUB_TOKEN=

# DeepSeek API key（OpenAI 兼容，base_url=https://api.deepseek.com）
DEEPSEEK_API_KEY=

# 后端监听地址，可留空，默认 :8080
ADDR=:8080

# 分析阶段整体超时（秒），可留空，默认 90。
# summary / risks / suggestions 三个 LLM 子任务并发跑、共享这一个 deadline。
ANALYZE_TIMEOUT_SECONDS=90

# 风险点置信度阈值，[0,1]，默认 0.5。
# detector 返回后做后置过滤，低于此阈值的 risk 被剔掉以控制误报；
# 越界自动夹紧，非法 / 空回落默认值。
RISK_CONFIDENCE_THRESHOLD=0.5
